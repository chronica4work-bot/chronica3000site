---
interface Props {
  names: string[];
  separator?: string;
}
const { names, separator = ', ' } = Astro.props;
const entries = names.map(name => ({
  name: name === '@kirill_armanich' ? 'Kira Uteshkaliev' : name,
  href: /^@[A-Za-z0-9._]{1,30}$/.test(name) ? 'https://www.instagram.com/' + name.slice(1) + '/' : null,
}));
---
{entries.map(({ name, href }, index) => (
  <Fragment>
    {index > 0 && separator}{href ? <a href={href} target="_blank" rel="noopener noreferrer">{name}</a> : name}
  </Fragment>
))}
<style>
  a { text-decoration: underline; text-underline-offset: 0.15em; }
</style>
